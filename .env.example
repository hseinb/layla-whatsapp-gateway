# Layla WhatsApp Warehouse Daemon Configuration

# Server configuration
PORT=3000
HOST=0.0.0.0

# API Security (Protect REST endpoints. Leave empty or set to require Bearer/x-api-key)
API_KEY=layla_warehouse_secret_key_change_me

# WhatsApp Session directory (Persists your WhatsApp login state across daemon restarts)
AUTH_DIR=./session_auth

# WhatsApp Linking mode:
# - Leave empty to use QR Code (shown in terminal and at http://localhost:3000/auth/qr)
# - Or provide the phone number with country code (e.g. 15551234567) to request an 8-character pairing code
PAIRING_PHONE_NUMBER=

# Outbound Rate Limiting & Anti-Ban Protection
# Milliseconds delay between consecutive outgoing messages
RATE_LIMIT_DELAY_MS=2000
# Random jitter delay (0 to RATE_LIMIT_JITTER_MS) added to each message
RATE_LIMIT_JITTER_MS=1500

# Webhook forwarding (Relay incoming customer/supplier replies to your backend ERP or service)
WEBHOOK_URL=
WEBHOOK_SECRET=
